            <div id="formContent">
                <div class="flex items-center gap-3 mb-2 text-blue-400">
                    <i class="fa-solid fa-lock"></i>
                    <h3 data-i18n="contactTitle" class="text-xl font-bold text-white">Inicie uma Conexão Segura</h3>
