                            <span data-i18n="antiBotText" class="text-slate-300 text-sm font-medium group-hover:text-white transition-colors">Verificação de Segurança (Humano)</span>
                        </div>
                        <i class="fa-solid fa-shield-virus text-emerald-500 text-xl"></i>
                    </div>
                    <button id="sendBtn" onclick="submitForm()" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold py-3.5 rounded-xl shadow-lg transition-all opacity-50 cursor-not-allowed mt-2 flex justify-center items-center gap-2" disabled>
