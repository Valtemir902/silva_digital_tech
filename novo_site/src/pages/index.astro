    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<body class="antialiased bg-slate-950 text-slate-100">

    <nav class="fixed w-full z-40 glass-nav py-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
            <div class="text-2xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-indigo-400 to-emerald-400">
                Silva Digital Tech
            </div>
            
            <div class="flex items-center gap-4 md:gap-6">
                <select id="langSelect" class="bg-slate-900 border border-slate-700 text-xs md:text-sm text-slate-300 rounded-lg px-2 py-1.5 focus:outline-none focus:border-blue-500 cursor-pointer">
                    <option value="pt">🇧🇷 PT</option>
                    <option value="en">🇺🇸 EN</option>
                    <option value="es">🇪🇸 ES</option>
                    <option value="fr">🇫🇷 FR</option>
                    <option value="de">🇩🇪 DE</option>
                    <option value="ru">🇷🇺 RU</option>
                    <option value="zh">🇨🇳 ZH</option>
                </select>
                
                <button onclick="openContactModal()" class="text-sm bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 transition-all duration-300 px-5 py-2.5 rounded-full font-semibold shadow-[0_0_15px_rgba(79,70,229,0.4)] hover:shadow-[0_0_25px_rgba(79,70,229,0.6)] text-white">
                    <i class="fa-solid fa-lock text-xs mr-1 opacity-70"></i> <span data-i18n="faleComigo">Fale Conosco</span>
                </button>
            </div>
        </div>
    </nav>

    <section class="min-h-screen flex items-center justify-center relative px-6 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-950/40 via-slate-950 to-slate-950">
        <div class="absolute inset-0 bg-[url('https://tailwindui.com/img/beams-home.jpg')] bg-center opacity-10 pointer-events-none"></div>
        <div class="text-center max-w-4xl z-10 mt-10">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-blue-400 text-xs font-bold uppercase tracking-widest mb-6 shadow-lg" data-aos="fade-down">
                <i class="fa-solid fa-code-branch"></i> Software House Global
            </div>

            <h2 data-i18n="heroTitle" class="text-5xl md:text-7xl font-black mb-8 leading-tight tracking-tight" data-aos="zoom-in" data-aos-duration="1000">
                Engenharia de Elite para <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Apps, Web e Softwares</span>
            </h2>
            <p data-i18n="heroSubtitle" class="text-lg md:text-xl text-slate-400 mb-10 max-w-2xl mx-auto font-light leading-relaxed" data-aos="fade-up" data-aos-delay="300">
                Desenvolvimento multiplataforma de alta performance, segurança de nível militar e arquitetura escalável. Conheça nosso ecossistema blindado.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center" data-aos="fade-up" data-aos-delay="500">
                <a href="#portfolio" class="bg-white text-slate-950 font-bold px-8 py-4 rounded-full shadow-2xl hover:scale-105 transition-all duration-300 w-full sm:w-auto tracking-wide">
                    <span data-i18n="exploreBtn">Explorar Portfólio</span>
                </a>
                
                <button onclick="openAboutModal()" class="bg-slate-900/80 border border-slate-700 text-white font-semibold px-8 py-4 rounded-full shadow-lg hover:bg-slate-800 hover:border-slate-600 transition-all duration-300 w-full sm:w-auto flex items-center justify-center gap-2">
                    <i class="fa-solid fa-fingerprint text-indigo-400"></i> <span data-i18n="btnAboutUs">Quem Somos</span>
                </button>
            </div>
        </div>
    </section>

    <div class="border-y border-slate-800 bg-slate-900/50 py-6 relative z-20">
        <div class="max-w-7xl mx-auto px-6 flex flex-wrap justify-center md:justify-between items-center gap-6 text-sm font-semibold text-slate-400">
            <div class="flex items-center gap-3"><i class="fa-solid fa-shield-halved text-emerald-500 text-xl"></i> <span data-i18n="sec1">Criptografia de Ponta a Ponta</span></div>
            <div class="flex items-center gap-3"><i class="fa-solid fa-server text-blue-500 text-xl"></i> <span data-i18n="sec2">Proteção Anti-DDoS e Anti-Spam</span></div>
            <div class="flex items-center gap-3"><i class="fa-solid fa-robot text-indigo-500 text-xl"></i> <span data-i18n="sec3">Auditoria de Código via IA</span></div>
        </div>
    </div>

    <section id="portfolio" class="py-32 px-6 max-w-7xl mx-auto relative overflow-hidden">
        <div class="absolute -left-40 top-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute -right-40 bottom-20 w-96 h-96 bg-blue-500/10 rounded-full blur-[100px] pointer-events-none"></div>

        <h3 data-i18n="portfolioTitle" class="relative z-10 text-4xl md:text-5xl font-extrabold mb-20 text-center tracking-tight text-white" data-aos="fade-up">
            Nosso Portfólio Global
        </h3>
        
        <!-- APLICATIVOS MOBILE -->
        <div class="mb-20" data-aos="fade-up">
            <div class="flex items-center gap-4 mb-8">
                <i class="fa-solid fa-mobile-screen text-2xl text-emerald-400"></i>
                <h4 data-i18n="catMobile" class="text-2xl font-bold text-white border-b border-slate-800 pb-2 w-full">Aplicativos Mobile</h4>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8 relative z-10">
                <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition-all duration-500 group">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <img src="/apps/agro-expert/assets/favicon.png" alt="Ícone Agro Expert" class="w-16 h-16 rounded-2xl shadow-xl shadow-emerald-500/20 object-cover border border-slate-700/50 group-hover:scale-110 transition-transform duration-500">
                            <span class="text-[10px] font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1.5 rounded-full uppercase"><i class="fa-solid fa-lock text-xs mr-1"></i> ERP Seguro</span>
                        </div>
                        <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-400 transition-colors">Agro Expert</h4>
                        <p data-i18n="agroDesc" class="text-slate-400 text-sm leading-relaxed mb-6">O ERP agrícola mais completo na palma da sua mão. Tecnologia de precisão e IA para monitoramento rural, funcionando 100% offline.</p>
                    </div>
                    <a href="/apps/agro-expert/index.html" class="inline-flex items-center gap-3 text-emerald-400 text-sm font-semibold group-hover:text-emerald-300 transition-colors bg-emerald-500/10 hover:bg-emerald-500/20 px-5 py-2.5 rounded-xl w-max">
                        <span data-i18n="verApp">Ver página oficial &rarr;</span>
                    </a>
                </div>

                <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-cyan-500/50 hover:shadow-[0_0_30px_rgba(34,211,238,0.15)] transition-all duration-500 group">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <img src="/apps/trilha-navigator/assets/favicon.png" alt="Ícone Trilha Navigator" class="w-16 h-16 rounded-2xl shadow-xl shadow-cyan-500/20 object-cover border border-slate-700/50 group-hover:scale-110 transition-transform duration-500">
                            <div class="flex flex-col items-end gap-2">
                                <span class="text-[10px] font-bold bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 px-3 py-1.5 rounded-full uppercase"><i class="fa-solid fa-satellite text-xs mr-1"></i> Radar Mesh</span>
                                <span class="text-[10px] font-bold bg-blue-500/10 border border-blue-500/30 text-blue-400 px-3 py-1.5 rounded-full uppercase"><i class="fa-brands fa-google-play text-xs mr-1"></i> Google Play</span>
                            </div>
                        </div>
                        <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-cyan-400 transition-colors">Trilha Navigator</h4>
                        <p data-i18n="trilhaDesc" class="text-slate-400 text-sm leading-relaxed mb-6">Sua bússola definitiva para a aventura. Sistema de navegação GPS robusto que não depende de sinal de internet para guiar suas rotas.</p>
                    </div>
                    <a href="/apps/trilha-navigator/index.html" class="inline-flex items-center gap-3 text-cyan-400 text-sm font-semibold group-hover:text-cyan-300 transition-colors bg-cyan-500/10 hover:bg-cyan-500/20 px-5 py-2.5 rounded-xl border border-cyan-500/20 w-max">
                        <span data-i18n="verApp">Ver página oficial &rarr;</span>
                    </a>
                </div>

                <!-- Renderização Dinâmica: Aplicativos Mobile criados pelo Painel -->
                {appsMobile.map((app: any) => (
                    <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition-all duration-500 group">
                        <div>
                            <div class="flex justify-between items-start mb-6">
                                <img src={app.frontmatter.icone} alt={app.frontmatter.title} class="w-16 h-16 rounded-2xl shadow-xl shadow-emerald-500/20 object-cover border border-slate-700/50 group-hover:scale-110 transition-transform duration-500" />
                                <span class="text-[10px] font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1.5 rounded-full uppercase">{app.frontmatter.tag}</span>
                            </div>
                            <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-400 transition-colors">{app.frontmatter.title}</h4>
                            <p class="text-slate-400 text-sm leading-relaxed mb-6">{app.frontmatter.descricao}</p>
                        </div>
                        <a href={app.frontmatter.link} target="_blank" class="inline-flex items-center gap-3 text-emerald-400 text-sm font-semibold group-hover:text-emerald-300 transition-colors bg-emerald-500/10 hover:bg-emerald-500/20 px-5 py-2.5 rounded-xl w-max">
                            <span>Acessar Ferramenta &rarr;</span>
                        </a>
                    </div>
                ))}
            </div>
        </div>

        <!-- SOFTWARES & AUTOMAÇÕES -->
        <div class="mb-20" data-aos="fade-up">
            <div class="flex items-center gap-4 mb-8">
                <i class="fa-brands fa-python text-2xl text-yellow-400"></i>
                <h4 data-i18n="catSoftware" class="text-2xl font-bold text-white border-b border-slate-800 pb-2 w-full">Softwares & Automações</h4>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8 relative z-10">
                <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-yellow-500/50 hover:shadow-[0_0_30px_rgba(234,179,8,0.15)] transition-all duration-500 group">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <div class="w-16 h-16 bg-slate-800 border border-slate-700 rounded-2xl flex items-center justify-center text-3xl shadow-xl shadow-yellow-500/10 group-hover:scale-110 transition-transform duration-500">
                                🎬
                            </div>
                            <span data-i18n="emDesenvolvimento" class="text-[10px] font-bold bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 px-3 py-1.5 rounded-full uppercase">Em Desenvolvimento</span>
                        </div>
                        <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-yellow-400 transition-colors">ProFrame Editor</h4>
                        <p data-i18n="proframeDesc" class="text-slate-400 text-sm leading-relaxed mb-6">Software de edição de vídeo avançada construído em Python. Pipeline de renderização automatizada e ferramentas de pós-produção profissional.</p>
                    </div>
                </div>

                <!-- Renderização Dinâmica: Softwares criados pelo Painel -->
                {softwaresWin.map((app: any) => (
                    <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-yellow-500/50 hover:shadow-[0_0_30px_rgba(234,179,8,0.15)] transition-all duration-500 group">
                        <div>
                            <div class="flex justify-between items-start mb-6">
                                <img src={app.frontmatter.icone} alt={app.frontmatter.title} class="w-16 h-16 rounded-2xl shadow-xl shadow-yellow-500/20 object-cover border border-slate-700/50 group-hover:scale-110 transition-transform duration-500" />
                                <span class="text-[10px] font-bold bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 px-3 py-1.5 rounded-full uppercase">{app.frontmatter.tag}</span>
                            </div>
                            <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-yellow-400 transition-colors">{app.frontmatter.title}</h4>
                            <p class="text-slate-400 text-sm leading-relaxed mb-6">{app.frontmatter.descricao}</p>
                        </div>
                        <a href={app.frontmatter.link} target="_blank" class="inline-flex items-center gap-3 text-yellow-400 text-sm font-semibold group-hover:text-yellow-300 transition-colors bg-yellow-500/10 hover:bg-yellow-500/20 px-5 py-2.5 rounded-xl w-max">
                            <span>Acessar Ferramenta &rarr;</span>
                        </a>
                    </div>
                ))}
            </div>
        </div>

        <!-- SOLUÇÕES WEB & SITES -->
        <div data-aos="fade-up">
            <div class="flex items-center gap-4 mb-8">
                <i class="fa-solid fa-laptop-code text-2xl text-indigo-400"></i>
                <h4 data-i18n="catWeb" class="text-2xl font-bold text-white border-b border-slate-800 pb-2 w-full">Soluções Web & Sites</h4>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8 relative z-10">
                <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-indigo-500/50 hover:shadow-[0_0_30px_rgba(99,102,241,0.15)] transition-all duration-500 group">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <div class="w-16 h-16 bg-slate-800 border border-slate-700 rounded-2xl flex items-center justify-center text-3xl shadow-xl shadow-indigo-500/10 group-hover:scale-110 transition-transform duration-500">
                                🌐
                            </div>
                            <span data-i18n="sobMedida" class="text-[10px] font-bold bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 px-3 py-1.5 rounded-full uppercase">Soluções sob Medida</span>
                        </div>
                        <h4 class="text-2xl font-bold mb-3 text-white group-hover:text-indigo-400 transition-colors">Plataformas Web</h4>
                        <p data-i18n="webDesc" class="text-slate-400 text-sm leading-relaxed mb-6">Desenvolvimento de landing pages otimizadas, e-commerces e Web Apps progressivos (PWA) de altíssima performance e SEO dominante.</p>
                    </div>
                </div>

                <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition-all duration-500 group">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <div class="w-16 h-16 bg-gradient-to-br from-slate-800 to-slate-900 border border-emerald-500/40 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(16,185,129,0.2)] group-hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] group-hover:border-emerald-400 group-hover:scale-110 transition-all duration-500 relative overflow-hidden">
                                <div class="absolute inset-0 bg-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                                <svg class="w-8 h-8 text-emerald-400 relative z-10 drop-shadow-[0_0_8px_rgba(52,211,153,0.8)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    <circle cx="9" cy="15" r="1.5" fill="#fff" stroke="none"></circle>
                                    <circle cx="12" cy="11" r="1.5" fill="#fff" stroke="none"></circle>
                                    <circle cx="15" cy="15" r="1.5" fill="#fff" stroke="none"></circle>
                                </svg>
                            </div>
                            <span data-i18n="tagFreeTool" class="text-[10px] font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1.5 rounded-full uppercase">Ferramenta Gratuita</span>
                        </div>
                        <h4 data-i18n="crmTitle" class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-400 transition-colors">MicroCRM: Recibos & Orçamentos</h4>
                        <p data-i18n="crmDesc" class="text-slate-400 text-sm leading-relaxed mb-6">Gerador profissional de PDFs em tempo real. Funciona offline, sem mensalidades. Calcule taxas, aplique descontos e gerencie clientes direto do navegador.</p>
                    </div>
                    <a href="/gerador-de-recibos-e-orcamentos/" target="_blank" class="inline-flex items-center gap-3 text-emerald-400 text-sm font-semibold group-hover:text-emerald-300 transition-colors bg-emerald-500/10 hover:bg-emerald-500/20 px-5 py-2.5 rounded-xl w-max">
                        <span data-i18n="btnAcessarTool">Acessar Ferramenta &rarr;</span>
                    </a>
                </div>

                <!-- Renderização Dinâmica: Web Apps criados pelo Painel -->
                {solucoesWeb.map((app: any) => (
                    <div class="glass-card bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 flex flex-col justify-between hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)] transition-all duration-500 group">
