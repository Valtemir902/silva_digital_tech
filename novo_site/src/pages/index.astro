                            <div class="flex justify-between items-start mb-6">
                                <img src={app.frontmatter.icone} alt={app.frontmatter.title} class="w-16 h-16 rounded-2xl shadow-xl shadow-blue-500/20 object-cover border border-slate-700/50 group-hover:scale-110 transition-transform duration-500" />
