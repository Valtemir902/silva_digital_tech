        <div class="bg-slate-900 border border-slate-700 rounded-3xl p-8 max-w-2xl w-full shadow-[0_0_50px_rgba(0,0,0,0.8)] relative transform scale-95 transition-transform duration-300" id="aboutModalBox">
            <button onclick="closeAboutModal()" class="absolute top-6 right-6 text-slate-400 hover:text-white transition-colors bg-slate-800 rounded-full w-8 h-8 flex items-center justify-center">
