    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    <script src="/js/i18n.js" is:inline></script>
    <script is:inline>
        AOS.init({ once: true, offset: 60 });
        function openAboutModal() { const m = document.getElementById('aboutModal'); const b = document.getElementById('aboutModalBox'); m.classList.remove('hidden'); m.classList.add('flex'); setTimeout(() => { m.classList.remove('opacity-0'); b.classList.remove('scale-95'); b.classList.add('scale-100'); }, 10); }
        function closeAboutModal() { const m = document.getElementById('aboutModal'); const b = document.getElementById('aboutModalBox'); m.classList.add('opacity-0'); b.classList.remove('scale-100'); b.classList.add('scale-95'); setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300); }
        let isHuman = false;
        function openContactModal() { const m = document.getElementById('contactModal'); const b = document.getElementById('contactModalBox'); document.getElementById('formContent').classList.remove('hidden'); document.getElementById('successContent').classList.add('hidden'); document.getElementById('successContent').classList.remove('flex'); isHuman = false; updateBotUI(); m.classList.remove('hidden'); m.classList.add('flex'); setTimeout(() => { m.classList.remove('opacity-0'); b.classList.remove('scale-95'); b.classList.add('scale-100'); }, 10); }
        function closeContactModal() { const m = document.getElementById('contactModal'); const b = document.getElementById('contactModalBox'); m.classList.add('opacity-0'); b.classList.remove('scale-100'); b.classList.add('scale-95'); setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300); }
        let isHuman = false;
        function toggleBotCheck() { isHuman = !isHuman; updateBotUI(); }
        function updateBotUI() { const c = document.getElementById('botCheckbox'); const i = document.getElementById('botCheckIcon'); const btn = document.getElementById('sendBtn'); if(isHuman) { c.classList.add('bg-emerald-500', 'border-emerald-500'); c.classList.remove('border-slate-600'); i.classList.remove('opacity-0'); btn.classList.remove('opacity-50', 'cursor-not-allowed'); btn.disabled = false; } else { c.classList.remove('bg-emerald-500', 'border-emerald-500'); c.classList.add('border-slate-600'); i.classList.add('opacity-0'); btn.classList.add('opacity-50', 'cursor-not-allowed'); btn.disabled = true; } }
        function submitForm() { const btn = document.getElementById('sendBtn'); const icon = btn.querySelector('i'); icon.className = "fa-solid fa-circle-notch fa-spin"; btn.querySelector('span').textContent = "Criptografando dados..."; setTimeout(() => { document.getElementById('formContent').classList.add('hidden'); const s = document.getElementById('successContent'); s.classList.remove('hidden'); s.classList.add('flex'); icon.className = "fa-solid fa-paper-plane"; btn.querySelector('span').textContent = "Enviar Mensagem Segura"; }, 1500); }
        window.addEventListener('langChanged', (e) => {
            const lang = e.detail; const schemaElement = document.getElementById('jsonld-schema');
            if (schemaElement) {
                let orgDesc = "Software House global especializada em Inteligência Artificial, automação em Python, aplicativos mobile e sistemas web de alta performance.";
                if (lang === 'en') orgDesc = "Global Software House specialized in Artificial Intelligence, Python automation, high-performance mobile applications, and web systems.";
                else if (lang === 'es') orgDesc = "Software House global especializada en Inteligência Artificial, automatización en Python, aplicaciones móviles de alto rendimiento y sistemas web.";
                else if (lang === 'fr') orgDesc = "Software House mondiale spécialisée dans l'Intelligence Artificielle, l'automatisation Python, les applications mobiles et les systèmes web.";
                else if (lang === 'de') orgDesc = "Globales Softwarehaus, spezialisiert auf Künstliche Intelligenz, Python-Automatisierung, mobile Apps und Websysteme.";
                else if (lang === 'ru') orgDesc = "Глобальная компания по разработке ПО, специализирующаяся на искусственном интеллекте, автоматизации Python и мобильных приложениях.";
                else if (lang === 'zh') orgDesc = "全球软件公司，专注于人工智能、Python 自动化、高性能移动应用程序和网络系统。";
                const baseUrl = window.location.href.split('?')[0];
                const schemaData = { "@context": "https://schema.org", "@graph": [ { "@type": "Organization", "@id": baseUrl + "#organization", "name": "Silva Digital Tech", "url": baseUrl, "description": orgDesc, "contactPoint": { "@type": "ContactPoint", "email": "silvadigitaltech@gmail.com", "contactType": "customer support" } }, { "@type": "WebSite", "@id": baseUrl + "#website", "url": baseUrl, "name": "Silva DigitalTech", "publisher": { "@id": baseUrl + "#organization" } } ] };
                schemaElement.text = JSON.stringify(schemaData);
            }
        });
    </script>

    <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>

