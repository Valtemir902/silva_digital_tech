                <div class="space-y-4">
                    <div><input type="email" data-i18n="formEmail" placeholder="Seu melhor e-mail" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors"></div>
                    <div><textarea rows="4" data-i18n="formMessage" placeholder="Descreva seu projeto ou dúvida..." class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea></div>
                    <div class="bg-slate-950 border border-slate-700 rounded-xl p-4 flex items-center justify-between cursor-pointer group" onclick="toggleBotCheck()">
                        <div class="flex items-center gap-3">
                            <div id="botCheckbox" class="w-6 h-6 border-2 border-slate-600 rounded flex items-center justify-center transition-colors">
                                <i class="fa-solid fa-check text-white text-xs opacity-0" id="botCheckIcon"></i>
