---
import '../styles/global.css';

// Solução definitiva exigida pela Netlify e Astro v5+: import.meta.glob
const postModules = import.meta.glob('../content/aplicativos/*.md', { eager: true });
const aplicativos = Object.values(postModules);

// Distribuindo os apps nas vitrines corretas
const appsMobile = aplicativos.filter((app: any) => app.frontmatter?.categoria === 'Aplicativos Mobile');
const softwaresWin = aplicativos.filter((app: any) => app.frontmatter?.categoria === 'Softwares & Automações');
const solucoesWeb = aplicativos.filter((app: any) => app.frontmatter?.categoria === 'Soluções Web & Sites');
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Silva Digital Tech | Apps, Web e Sistemas</title>
    
    <link rel="icon" type="image/svg+xml" href="/assets/icone-silva.svg">
    <link rel="apple-touch-icon" href="/assets/icone-silva.svg">
    
    <meta name="google-site-verification" content="Klqpt3kAsGcRwmW459DGKkt10X_BXAxgc-TCfurlVaY" />
    <meta name="description" content="Software House global. Desenvolvimento avançado de aplicativos Mobile (Flutter), Web Apps (PWA) e Softwares de Automação (Python) com Inteligência Artificial e segurança militar.">
    <meta name="keywords" content="Software House, Desenvolvedor de Software, Criar Aplicativo, Desenvolvimento Web, Automação em Python, Inteligência Artificial, ERP Agrícola, GPS Offline, Flutter Developer, Segurança Cibernética, SaaS, Silva Digital Tech">
